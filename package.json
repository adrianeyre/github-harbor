{
  "name": "repo-harbor",
  "version": "1.0.0",
  "private": true,
  "description": "Bulk clone and update every repository from a GitHub organisation or user onto a NAS or local disk.",
  "repository": {
    "type": "git",
    "url": "https://github.com/adrianeyre/github-clone.git"
  },
  "homepage": "https://adrianeyre.github.io/github-clone/",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "release": "semantic-release"
  },
  "devDependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@types/node": "^22.20.5",
    "semantic-release": "^25.0.9",
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "vitest": "^3.2.7"
  }
}
