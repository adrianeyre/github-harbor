{
  "name": "github-harbor",
  "version": "1.0.0",
  "private": true,
  "description": "Repo Harbor: a website that writes ready-to-run PowerShell and Bash scripts for Windows, macOS and Linux to clone every repository of a GitHub organisation or user into its own folder on a NAS or local disk, and to keep them up to date by stashing local changes and fast-forwarding main or master.",
  "keywords": [
    "github",
    "git",
    "clone",
    "bulk-clone",
    "backup",
    "nas",
    "organisation",
    "git-pull",
    "git-stash",
    "powershell",
    "bash",
    "windows",
    "macos",
    "linux"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/adrianeyre/github-harbor.git"
  },
  "homepage": "https://adrianeyre.github.io/github-harbor/",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "release": "semantic-release"
  },
  "devDependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@types/node": "^22.20.5",
    "semantic-release": "^25.0.9",
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "vitest": "^3.2.7"
  }
}
